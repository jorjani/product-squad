#!/bin/bash
# scope — V0.5 product cluster wrapper
#
# Writes 7 pre-filled prompts (the commander's intent + scoping ladder)
# to a temp dir. Paste each into Claude Code in sequence — each stage's
# output feeds the next.
#
# Usage: scope "your feature idea in one sentence"
#
# The 7 stages teach a transferable product-craft pattern:
#   1. /why         frame the outcome (job-to-be-done)
#   2. /vet         does this serve the mission? (cheap kill — STOP if Off-mission)
#   3. /shape       decide what to build (options menu + cuts)
#   4. /experience  articulate the user delta
#   5. /owit        map scenarios (On/When/If/Then) + choices
#   6. /elon        ruthless cut (question, delete, simplify)
#   7. /spec        consolidate the conversation into one authoritative spec
#
# Precursor (run once per product, not per feature): /mission writes
# design-system/mission.md — the vision /vet judges each feature against.
#
# REQUIREMENTS:
#   - Claude Code installed (https://claude.com/claude-code)
#   - Signed in via subscription: run `claude /login` once
#   - NO Anthropic API key required (but unset ANTHROPIC_API_KEY if set —
#     it shadows subscription auth)

set -euo pipefail

IDEA="${1:-}"
if [ -z "$IDEA" ]; then
  cat <<'USAGE'
Usage: scope "your feature idea in one sentence"

Example:
  scope "users configure notification preferences across email, push, and in-app channels"

Writes 7 pre-filled prompts to a temp dir. Each prompt has your idea
inserted at the end. Paste each into Claude Code in sequence.

See examples/idea-fixture.md for more sample ideas + phrasing guidance.
USAGE
  exit 1
fi

# Locate repo root. After the bin/ flatten, the script lives at the repo
# root itself — SCRIPT_DIR is the repo root, no `..` traversal needed.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"

OUT_DIR="/tmp/product-squad-scope-$(date +%s)"
mkdir -p "$OUT_DIR"

cat <<EOF
═══════════════════════════════════════════════════════════════════
  Product Squad — Commander's Intent + Scoping Ladder (V0.5)
═══════════════════════════════════════════════════════════════════
  Idea:        $IDEA
  Output dir:  $OUT_DIR

  7 pre-filled prompts written below. Each teaches a transferable
  product-craft pattern. Paste each into Claude Code in sequence —
  each stage's output feeds the next.

EOF

# Column width for aligning the "→ $out" arrow across stages (longest cmd is "experience" = 10).
CMD_COL_WIDTH=14

write_stage() {
  local num="$1"
  local cmd="$2"
  local teaches="$3"
  local cmd_path="$REPO_ROOT/skills/$cmd/SKILL.md"
  local out="$OUT_DIR/$num-$cmd.md"

  if [ ! -f "$cmd_path" ]; then
    echo "  ✗ Stage $num — /$cmd: source missing at $cmd_path"
    return 1
  fi

  cat > "$out" <<HEADER
# Stage $num/7 — /$cmd
# Teaches: $teaches
#
# COPY EVERYTHING FROM THE HORIZONTAL RULE BELOW TO THE END OF
# THIS FILE INTO CLAUDE CODE. Claude will respond with the scoped output.

---

HEADER
  # Strip $ARGUMENTS literal token (Claude Code slash-command interpolation
  # placeholder) — scope doesn't run as a slash command, so the token
  # would leak as raw text into the prompt and confuse the reader.
  sed 's/\$ARGUMENTS//g' "$cmd_path" >> "$out"
  cat >> "$out" <<FOOTER

---

Apply the above to this idea:

> $IDEA
FOOTER

  local pad
  pad=$(printf '%*s' $((CMD_COL_WIDTH - ${#cmd})) '')
  echo "  ✓ Stage $num — /$cmd $pad → $out"
}

write_stage 1 "why"        "Frame the outcome (job-to-be-done)"
write_stage 2 "vet"        "Mission-fit gate (STOP if Off-mission)"
write_stage 3 "shape"      "Decide what to build (options menu + cuts)"
write_stage 4 "experience" "Articulate the felt user delta"
write_stage 5 "owit"       "Map scenarios (On/When/If/Then) + choices"
write_stage 6 "elon"       "Ruthless cut (question, delete, simplify)"
write_stage 7 "spec"       "Consolidate the conversation into one spec"

cat <<EOF

═══════════════════════════════════════════════════════════════════
  Done. All 7 prompt files in: $OUT_DIR

  Suggested flow (copy each stage's file to your clipboard, paste into
  Claude Code, read response, then proceed to the next stage):

    # macOS:    cat $OUT_DIR/1-why.md | pbcopy
    # Linux:    cat $OUT_DIR/1-why.md | xclip -selection clipboard
    # Wayland:  cat $OUT_DIR/1-why.md | wl-copy

    # Then in Claude Code: paste, read the response, move to stage 2.
    # If /vet (stage 2) returns Off-mission, STOP — the rest is wasted
    # effort on a feature that doesn't belong. Otherwise repeat to stage 7.

  Or open the dir to view all 7 stage files:
    open $OUT_DIR        # macOS
    xdg-open $OUT_DIR    # Linux

  Cost: ~\$0.40-0.70 total in Claude Code subscription usage if you
  work through all 7 stages with deep responses.

  TIP: /why, /experience, /spec are quick (one main pass). /vet is a gate — if it
  returns Off-mission, STOP. /shape, /owit, /elon are multi-turn —
  they'll ask you to pick options or review choices.
═══════════════════════════════════════════════════════════════════
EOF
