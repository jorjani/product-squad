#!/bin/bash
# draw — V0.5 demo wrapper for the visual fidelity ladder
#
# Usage: draw "your feature idea in one sentence"
#
# Runs sketch + wireframe + mockup + prototype against the idea, writes
# outputs to /tmp/product-squad-demo-<timestamp>/, opens each HTML in
# your default browser.
#
# REQUIREMENTS:
#   - Claude Code installed (https://claude.com/claude-code)
#   - Signed in via subscription: run `claude /login` once
#   - NO Anthropic API key required
#
# GOTCHA: If ANTHROPIC_API_KEY is set in your environment, unset it first.
# It shadows subscription auth and may fail with org-mismatch errors:
#   unset ANTHROPIC_API_KEY

set -euo pipefail

IDEA="${1:-}"
if [ -z "$IDEA" ]; then
  cat <<'USAGE'
Usage: draw "your feature idea in one sentence"

Example:
  draw "users configure notification preferences across email, push, and in-app channels"

The wrapper runs 4 visual tiers in sequence:
  T0  sketch     — ASCII layout, printed to terminal
  T1  wireframe  — multi-state HTML, opens in browser
  T3  mockup     — hi-fi HTML with bundled design tokens, opens in browser
  T4  prototype  — interactive HTML, opens in browser

  (T2 /schematic — annotation overlay — is documented as optional in
   the ladder and not included in V0.5.)

See examples/idea-fixture.md for more sample ideas.
USAGE
  exit 1
fi

# Locate repo root. After the bin/ flatten, the script lives at the repo
# root itself — SCRIPT_DIR is the repo root, no `..` traversal needed.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"

# Load project context from .studio/project.json if it exists (written by
# ./onboard). Provides per-operator defaults for FLAVOR and BRAND. CLI env
# vars take precedence; project.json takes precedence over hardcoded defaults.
PROJECT_FILE="$REPO_ROOT/.studio/project.json"
PROJECT_FLAVOR=""
PROJECT_BRAND=""
if [ -f "$PROJECT_FILE" ] && command -v python3 >/dev/null 2>&1; then
  PROJECT_FLAVOR=$(python3 -c "import json; print(json.load(open('$PROJECT_FILE')).get('default_flavor',''))" 2>/dev/null || echo "")
  PROJECT_BRAND=$(python3 -c "import json; print(json.load(open('$PROJECT_FILE')).get('brand',''))" 2>/dev/null || echo "")
fi

# Resolve FLAVOR. Precedence: env var > project.json > hardcoded `linear`.
# Unknown name falls back with a warning so a typo doesn't silently apply the
# wrong tokens. .studio/design.md is the authoritative list; this script
# duplicates the names for the fallback check so cold-start runs don't need to
# parse markdown.
FLAVOR="${FLAVOR:-${PROJECT_FLAVOR:-linear}}"
FLAVOR_PATH="$REPO_ROOT/.studio/brand-flavors/$FLAVOR.md"
if [ ! -f "$FLAVOR_PATH" ]; then
  echo "⚠ FLAVOR='$FLAVOR' not found at $FLAVOR_PATH — falling back to linear."
  echo "  Available flavors: linear, apple, airbnb, uber"
  echo "  See .studio/design.md for the full list."
  echo ""
  FLAVOR="linear"
  FLAVOR_PATH="$REPO_ROOT/.studio/brand-flavors/linear.md"
fi

# Brand placeholder. The model otherwise invents specific real-world identifiers
# (e.g., CSC301 for an EDU idea) which read as wrong outside the operator's
# geography. Precedence: env var > project.json > hardcoded `AcmeU 101 · ReviewLab`.
BRAND="${BRAND:-${PROJECT_BRAND:-AcmeU 101 · ReviewLab}}"

OUT_DIR="/tmp/product-squad-demo-$(date +%s)"
mkdir -p "$OUT_DIR"

# Slug for the issue-number stand-in (prevents path collisions)
SLUG=$(echo "$IDEA" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//' | head -c 40)

echo "═══════════════════════════════════════════════════════════════════"
echo "  Product Squad — Visual Fidelity Ladder Demo (V0.5)"
echo "═══════════════════════════════════════════════════════════════════"
echo "  Idea:       $IDEA"
echo "  Flavor:     $FLAVOR  ($FLAVOR_PATH)"
echo "  Brand:      $BRAND"
echo "  Output dir: $OUT_DIR"
echo "  Slug:       $SLUG"
echo "═══════════════════════════════════════════════════════════════════"
echo ""

# Verify claude CLI is available
if ! command -v claude >/dev/null 2>&1; then
  echo "✗ 'claude' CLI not found. Install Claude Code: https://claude.com/claude-code"
  exit 1
fi

# Warn about ANTHROPIC_API_KEY shadowing
if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  echo "⚠ ANTHROPIC_API_KEY is set in your environment."
  echo "  It will shadow subscription auth. If you see org-mismatch errors,"
  echo "  unset it: unset ANTHROPIC_API_KEY"
  echo ""
fi

run_tier() {
  local tier="$1"
  local tier_num="$2"
  local out_ext="$3"
  local predecessors="${4:-}"   # comma-separated predecessor file paths (optional)
  local cmd_path="$REPO_ROOT/commands/$tier.md"
  local out_path="$OUT_DIR/$tier.$out_ext"

  if [ ! -f "$cmd_path" ]; then
    echo "✗ $tier: command file not found at $cmd_path — skipping"
    return 1
  fi

  echo "── T$tier_num: $tier ──"
  echo "  Generating..."

  # Build predecessor block — critical for the ladder to actually chain
  # (mockup must read wireframe; prototype must read both). Without this
  # each tier generates independently from the raw idea, breaking the
  # "progressively higher fidelity of the SAME design" promise.
  local predecessor_block=""
  if [ -n "$predecessors" ]; then
    predecessor_block=$'\n- **Predecessor artifacts — READ THESE FIRST** so this tier builds on the prior tier\'s output, not from scratch: '"$predecessors"
  fi

  # Compose meta-prompt into a temp file. Earlier the prompt was built via
  # prompt=$(cat <<EOF ... EOF), but bash's $() parser is fragile when the
  # heredoc body contains quote-pair patterns (e.g. apostrophes inside parens).
  # Writing to a file then piping via stdin sidesteps that parser entirely.
  local prompt_file="$OUT_DIR/.${tier}-prompt.tmp"
  {
    cat "$cmd_path"
    cat <<EOF

---

# DEMO MODE OVERRIDE (V0.5)

Apply the above instructions to this idea:

> $IDEA

**Demo-mode adjustments** (these override the workflow above where they conflict):

- Skip the GitHub issue lookup. Treat the issue number as "$SLUG" and the repo as the product-squad bundle.
- Skip multi-turn clarifying questions. Make sensible defaults and proceed.
- For HTML outputs (wireframe, mockup, prototype): write the COMPLETE self-contained HTML file (with all CSS inline) to this exact path: $out_path
- For ASCII / Mermaid outputs (sketch): write the COMPLETE sketch (ASCII layout or Mermaid diagram) to this exact path: $out_path. The wrapper script will print it back to the terminal after you finish, so downstream tiers can read it as a predecessor.
- Design flavor: read $FLAVOR_PATH. This file is the FULL aesthetic vocabulary: palette, type, radii, surface treatment, and a Do's and Don'ts section. Apply both the tokens AND the negative constraints in the Do's and Don'ts verbatim. The flavor is the brand; the Don'ts are non-negotiable.
- Component primitives: read $REPO_ROOT/.studio/components.md. These are SEMANTIC primitives. The flavor file overlays styling opinions onto them.${predecessor_block}
- Brand chrome (page titles, breadcrumbs, course codes, company names, product names): use exactly this placeholder string verbatim: $BRAND. DO NOT invent specific real-world identifiers like CSC301 or Acme Corp — the operator-provided value above is the only allowed brand string.
- Self-explanatory rule: state labels and section headings must be plain-English sentences of 5 to 10 words that a first-time viewer can grasp in one glance. No abbreviations, no single-word state codes like S1 or S2, no jargon.
- For wireframe: produce multi-state HTML with state-toggle navigation. STATE COUNT CAP: 3 to 5 states maximum. Pick one happy-path plus 2 most-instructive edges. Breathable layout, generous whitespace between states. Wireframe is for IA exploration, not exhaustive state coverage.
- For mockup: SINGLE state HTML, brand-applied. Pick the most representative state from the wireframe and polish it. Inherit the wireframe layout for that one state. Do not re-decide structure.
- For prototype: single-file interactive HTML with vanilla JS for state transitions. STATE COUNT: 6 to 10 states. This is where exhaustive state coverage belongs. Inherit both wireframe layout and mockup aesthetics. Initial landing state must be the EMPTY or FIRST-USE state, not the populated dashboard, so the demo viewer can see the progression by clicking forward.

Begin the work. Do not ask questions. Write the file. Return a one-line confirmation when done.
EOF
  } > "$prompt_file"

  # Headless `claude -p` defaults to prompting on every tool use, with no human
  # to answer. acceptEdits whitelists Write/Edit (Bash stays gated). --add-dir
  # is needed because OUT_DIR is a sibling of CWD, not a child, and mockup +
  # prototype tiers read the predecessor HTML files from there.
  #
  # Tee the claude output to a per-tier log so we can both (a) stream it to the
  # terminal indented and (b) post-hoc grep for the subscription rate-limit
  # message, which sometimes fires AFTER the file has already been written.
  local claude_log="$OUT_DIR/.${tier}-claude.log"
  local claude_ok=1
  if ! claude --permission-mode acceptEdits --add-dir "$OUT_DIR" -p < "$prompt_file" 2>&1 | tee "$claude_log" | sed 's/^/    /'; then
    claude_ok=0
  fi

  # Success requires both: claude exited 0 AND wrote a non-empty file. An empty
  # file most often means claude printed to stdout instead of writing, or
  # crashed mid-write — either way downstream tiers shouldn't inherit it.
  if [ "$claude_ok" -eq 1 ] && [ -s "$out_path" ]; then
    echo "  ✓ Wrote: $out_path"
  elif [ -s "$out_path" ] && grep -qE "hit your limit|You've hit your limit|[Uu]sage limit" "$claude_log"; then
    # Subscription rate-limit fired but the file landed on disk before the
    # quota hit. Treat as success so Gabriel doesn't think the bundle is broken.
    # Anchored to the literal Claude Code quota strings (not the generic phrase
    # "rate limit") so model-generated content can't false-positive.
    echo "  ✓ Wrote: $out_path"
    echo "  (rate-limited; file appears to have saved before quota fired)"
  else
    echo "  ✗ $tier failed. Check 'claude /login' and try again."
    return 1
  fi

  # For sketch (the only non-HTML tier), echo the saved file back to terminal
  # so the user still sees the layout inline — preserves the prior UX while
  # persisting the artifact for downstream tiers to read as a predecessor.
  if [ "$out_ext" = "txt" ]; then
    echo "  ── Sketch ──"
    sed 's/^/    /' "$out_path"
  elif command -v open >/dev/null 2>&1; then
    open "$out_path"
    echo "  ✓ Opened in browser"
  else
    echo "  → Open manually: file://$out_path"
  fi
  echo ""
}

# Predecessor chaining: each tier builds on the prior tier's output rather
# than the raw idea. We only pass a predecessor path if it actually exists on
# disk — `|| true` swallows run_tier's return 1, so we must guard at the call
# site or downstream tiers would inherit a dead path with no warning.
run_tier "sketch" 0 "txt" "" || true

WIREFRAME_PRED=""
[ -s "$OUT_DIR/sketch.txt" ] && WIREFRAME_PRED="$OUT_DIR/sketch.txt"
run_tier "wireframe" 1 "html" "$WIREFRAME_PRED" || true

MOCKUP_PRED=""
[ -s "$OUT_DIR/wireframe.html" ] && MOCKUP_PRED="$OUT_DIR/wireframe.html"
run_tier "mockup" 3 "html" "$MOCKUP_PRED" || true

PROTOTYPE_PRED=""
for f in "$OUT_DIR/wireframe.html" "$OUT_DIR/mockup.html"; do
  [ -s "$f" ] && PROTOTYPE_PRED="${PROTOTYPE_PRED:+$PROTOTYPE_PRED,}$f"
done
run_tier "prototype" 4 "html" "$PROTOTYPE_PRED" || true

echo "═══════════════════════════════════════════════════════════════════"
echo "  Done. T0 sketch → T1 wireframe → T3 mockup → T4 prototype"
printf '  All artifacts: %s\n' "$OUT_DIR"
echo ""
echo "  Try the same idea with a different flavor:"
for ALT in linear apple airbnb uber; do
  [ "$ALT" = "$FLAVOR" ] && continue
  printf '    FLAVOR=%-7s ./draw %q\n' "$ALT" "$IDEA"
done
echo ""
echo "  Or shape the product around the idea (5-stage scoping cluster):"
printf '    ./scope %q\n' "$IDEA"
echo ""
echo "  Cost: ~\$0.30-0.50 in Claude Code subscription usage"
echo "  (each tier is one LLM call; total ~60-120 sec)"
echo "═══════════════════════════════════════════════════════════════════"
